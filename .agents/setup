#!/usr/bin/env bash
# Prepare an Amp orb for editing and validating these dotfiles.
#
# This installs the linters and runtimes needed to check the configs; it does
# not apply the dotfiles to the orb (no `mise bootstrap`, no symlinks into $HOME).
set -euo pipefail

step() {
  local name="$1"
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

install_apt_packages() {
  local packages=(zsh)
  local missing=()
  local pkg
  for pkg in "${packages[@]}"; do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q "install ok installed" || missing+=("$pkg")
  done
  if ((${#missing[@]})); then
    sudo apt-get update -qq
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -qq "${missing[@]}"
  else
    echo "already installed: ${packages[*]}"
  fi
}

install_mise() {
  if [[ -x "$HOME/.local/bin/mise" ]]; then
    "$HOME/.local/bin/mise" --version
  else
    curl -fsSL https://mise.run | MISE_QUIET=1 sh
  fi
}

# Tools used to check the configs in this repo (zsh, shell scripts, nvim
# init.lua, mise config). Versions follow config/mise/config.toml. They go in
# mise's global config so the repo's macOS-only config/mise/config.toml is not
# activated in the orb.
install_tools() {
  local tools=(neovim@stable stylua@latest shellcheck@latest shfmt@latest)
  local mise="$HOME/.local/bin/mise"
  "$mise" use --global --yes "${tools[@]}"

  # ~/.local/bin is already on PATH for Amp and login shells, so expose the
  # shims there instead of editing shell profiles.
  local bin
  for bin in nvim stylua shellcheck shfmt; do
    ln -sfn "$HOME/.local/share/mise/shims/$bin" "$HOME/.local/bin/$bin"
  done
  "$mise" reshim
}

step "apt packages" install_apt_packages
step "mise" install_mise
step "mise tools" install_tools
